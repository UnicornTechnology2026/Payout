PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Keep Cashfree credentials on the server only. Do not commit .env.
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2024-01-01
# Cashfree Payouts UPI transfer is intentionally disabled until your account is approved
# and the exact transfer flow / 2FA method is confirmed with Cashfree.
ENABLE_CASHFREE_PAYOUTS=false
